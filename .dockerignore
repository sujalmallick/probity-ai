# Build context for infra/*.Dockerfile (context = repo root). Keep secrets, local data and host builds out of images.
.git
.claude
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.hypothesis
**/.mypy_cache
**/.ruff_cache
**/node_modules
**/dist
apps/api/data
benchmark/real
*.db
*.db-*
*.sqlite
*.sqlite3
*.log
*.pem
*.key
*.p12
*.pfx
