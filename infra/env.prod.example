# Production settings for infra/docker-compose.yml.
#   cp infra/env.prod.example infra/.env.prod     (infra/.env.prod is git-ignored and excluded from Docker images)
#   docker compose --env-file infra/.env.prod -f infra/docker-compose.yml up -d --build
# Generate random values with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API, worker and scheduler refuse to start while anything REQUIRED is missing and print what to fix.

# ---------------------------------------------------------------- stack passwords (REQUIRED, random, ≥ 32 chars)
POSTGRES_PASSWORD=          # schema owner (migrations only)
PROBITY_APP_PASSWORD=       # runtime role (row-level security applies); set before the FIRST start, it is read once
REDIS_PASSWORD=
METRICS_TOKEN=              # /metrics needs "Authorization: Bearer <token>"

# ---------------------------------------------------------------- public URL / browser origin (REQUIRED)
PUBLIC_APP_URL=https://probity.example.com
CORS_ORIGINS=https://probity.example.com
CLERK_AUTHORIZED_PARTIES=https://probity.example.com

# ---------------------------------------------------------------- Cloudflare (REQUIRED)
# Zero Trust → Networks → Tunnels → Create (Docker) → copy the token; Public hostname → Service http://web:80
CLOUDFLARE_TUNNEL_TOKEN=
# R2 → create bucket → Manage R2 API tokens (Object Read & Write, this bucket only)
S3_BUCKET=probity-invoices
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- sign-in: Clerk (REQUIRED)
CLERK_ISSUER=https://<your-app>.clerk.accounts.dev
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=   # public key, baked into the web build
# CLERK_FRONTEND_API=https://clerk.probity.example.com   # if you use a Clerk custom domain

# ---------------------------------------------------------------- AI (REQUIRED: one provider and its key)
LLM_PROVIDER=anthropic        # anthropic | gemini
ANTHROPIC_API_KEY=            # when LLM_PROVIDER=anthropic
GEMINI_API_KEY=               # when LLM_PROVIDER=gemini (Google AI Studio → Get API key)
# Optional model overrides (defaults: anthropic claude-sonnet-5-5 / claude-opus-5-5, gemini gemini-3.5-flash-lite / gemini-3.8-flash)
# LLM_MODEL_FAST=
# LLM_MODEL_REASONING=

# ---------------------------------------------------------------- app encryption secrets (REQUIRED)
# Generate once with `python -m probity.bootstrap --generate-secrets` (or the command above) and back them up:
# losing FIELD_KEY_B64 makes stored bank numbers unreadable; changing HMAC_KEY breaks verification of older audit rows.
FIELD_KEY_B64=                # base64 of 32 random bytes
HMAC_KEY=                     # ≥ 32 random characters

# ---------------------------------------------------------------- optional integrations
TAVILY_API_KEY=               # web research; missing → "could not verify" for external reputation
RESEND_API_KEY=               # outbound verification emails
EMAIL_FROM=                   # "Accounts Payable <ap@probity.example.com>" (a Resend-verified domain)
EMAIL_ALLOWLIST=
EMAIL_SEND_TO_ANY=false
# Vendor replies by email (Cloudflare Email Routing → Email Worker that POSTs to /api/v1/webhooks/inbound-email):
# EMAIL_REPLY_DOMAIN=replies.probity.example.com
# INBOUND_EMAIL_SECRET=       # ≥ 32 random characters, shared with the Email Worker
# SENTRY_DSN=

# ---------------------------------------------------------------- limits (defaults shown)
# WORKSPACE_DAILY_CASE_LIMIT=25
# WORKSPACE_DAILY_TOKEN_LIMIT=3000000
# CASE_TOKEN_LIMIT=200000
# CASE_WEB_SEARCH_LIMIT=10
# MAX_UPLOAD_MB=10            # keep infra/nginx.conf client_max_body_size at MAX_UPLOAD_MB + 1
# RETENTION_YEARS=8           # docs/PRIVACY.md

# ---------------------------------------------------------------- local debug
# WEB_DEBUG_PORT=5180         # the web container on 127.0.0.1 only, for checking before the tunnel is configured

# ---------------------------------------------------------------- virus scanning (optional)
# Every uploaded PDF is rewritten without active content before storage, so no scanner runs by default.
# To add ClamAV (needs 1-3 GB RAM): run a clamav/clamav container on the backend network and set
# CLAMAV_HOST=clamav
