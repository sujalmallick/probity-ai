# Probity API settings. Copy to apps/api/.env (git-ignored) and fill in. Never commit real values.
# `python -m probity.bootstrap --generate-secrets` creates apps/api/.env from this file and fills the two app secrets.
# The API refuses to start until every REQUIRED value is set; it prints a live/missing checklist on startup.

ENV=dev                                   # dev | test | prod

# --- REQUIRED: PostgreSQL (local: docker compose -f infra/docker-compose.dev.yml up -d)
DATABASE_URL=postgresql+psycopg://probity_app:<app-role-password>@127.0.0.1:5434/probity
DATABASE_MIGRATE_URL=postgresql+psycopg://probity:<owner-password>@127.0.0.1:5434/probity

# --- REQUIRED: AI. Pick one provider and set its key.
LLM_PROVIDER=anthropic          # anthropic | gemini
ANTHROPIC_API_KEY=              # https://console.anthropic.com → API keys (LLM_PROVIDER=anthropic)
GEMINI_API_KEY=                 # https://aistudio.google.com → Get API key (LLM_PROVIDER=gemini)
# Model overrides; leave empty for the provider's defaults:
#   anthropic: fast claude-sonnet-5-5, reasoning claude-opus-5-5
#   gemini:    fast gemini-3.5-flash-lite, reasoning gemini-3.8-flash
LLM_MODEL_REASONING=
LLM_MODEL_FAST=

# --- REQUIRED: Clerk sign-in (Clerk dashboard → API keys). The web app needs VITE_CLERK_PUBLISHABLE_KEY in apps/web/.env.local.
CLERK_ISSUER=                             # https://<your-app>.clerk.accounts.dev
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5180

# --- REQUIRED: app secrets (generated by bootstrap; changing FIELD_KEY_B64 makes stored bank numbers unreadable)
FIELD_KEY_B64=
HMAC_KEY=

# --- optional: web research (Tavily). Missing → external reputation reports "could not verify".
TAVILY_API_KEY=

# --- optional: email (Resend). Missing → nothing is sent.
RESEND_API_KEY=
EMAIL_FROM=                               # "Accounts Payable <ap@your-verified-domain.com>"
EMAIL_ALLOWLIST=                          # comma-separated: the ONLY addresses that may receive email
EMAIL_SEND_TO_ANY=false                   # keep false until you deliberately enable real sending
# EMAIL_REPLY_DOMAIN=                     # replies to case+<id>@<domain> come back to the case
# INBOUND_EMAIL_SECRET=

# --- optional: background jobs. inline = inside the API process (default). celery needs REDIS_URL and a worker.
TASK_BACKEND=inline
# REDIS_URL=redis://127.0.0.1:6380/0

# --- optional: storage and virus scanning
STORAGE_BACKEND=local
# CLAMAV_HOST=localhost

# --- usage limits (reaching one stops the work cleanly and names the limit)
WORKSPACE_DAILY_CASE_LIMIT=25             # investigations per workspace per UTC day
WORKSPACE_DAILY_TOKEN_LIMIT=3000000       # AI tokens (input + output) per workspace per UTC day
CASE_TOKEN_LIMIT=200000                   # AI tokens (input + output) per case
CASE_WEB_SEARCH_LIMIT=10                  # web searches per case
MAX_UPLOAD_MB=10                          # invoice upload size
RETENTION_YEARS=8                         # how long invoices and cases are kept (docs/PRIVACY.md); nothing is deleted automatically
CASE_STALL_SECONDS=900                    # a running case with no progress for this long is ended (watchdog)

CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
PUBLIC_APP_URL=http://localhost:5180
