# Copy to .env and adjust. Never commit real secrets.
ENV=dev                      # dev | demo | test | prod  (prod refuses AUTH_MODE=local and dev secrets)
# Default: SQLite at apps/api/data/probity.db (absolute path resolved in code)
# DATABASE_URL=postgresql+psycopg://probity:probity@localhost:5432/probity

TOOLS_MODE=cached            # live | cached | mock   — cached replays recorded web/registry/WHOIS fixtures
LLM_MODE=mock                # live | cached | mock   — mock = deterministic schema-valid agents (offline)
AUTH_MODE=local              # local (seeded demo users, non-prod) | clerk

# Live LLM (LLM_MODE=live): Anthropic SDK reads ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=
LLM_MODEL_REASONING=claude-opus-5-5
LLM_MODEL_FAST=claude-sonnet-5-5

# Secrets — generate your own for anything beyond a local demo
# Dev defaults are used when unset; ENV=prod refuses to start with them.
# JWT_SECRET=<long random string>
# FIELD_KEY_B64=<32 random bytes, base64>   (AES-GCM for bank/PAN fields)
# HMAC_KEY=<random string>                  (match account numbers without decrypting)

# Demo: per-step delay so the agent timeline is readable on stage
AGENT_DELAY_MS=0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
